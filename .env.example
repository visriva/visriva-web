# Canonical site URL (no trailing slash). Used for OG, sitemap, robots, redirects.
NEXT_PUBLIC_SITE_URL=https://www.visriva.com

# WhatsApp Business number for wa.me links (digits only is fine; code strips non-digits).
# Studio default in code: 918884484828 — override here for production.
NEXT_PUBLIC_WHATSAPP_NUMBER=918884484828

# Contact (optional overrides; defaults match studio records from the house brief)
NEXT_PUBLIC_PHONE_DISPLAY="+91 88844 84828"
NEXT_PUBLIC_PHONE_TEL="+918884484828"
NEXT_PUBLIC_CONTACT_EMAIL=visriva.work@gmail.com

# Social (optional; site has defaults from visriva.co profiles)
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/visriva.co
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/visriva

# Supabase (required for saving quote leads via /api/leads)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only: never expose in the browser. Used by /api/leads and /admin lead table.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Simple password gate for /admin (lead inbox). Set a long random string.
ADMIN_PASSWORD=

# Secret used to sign the session cookie (use a long random string; can differ from ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=

# Optional: printed in footer when set
NEXT_PUBLIC_GSTIN=

